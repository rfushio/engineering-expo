    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "three": "^0.187.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  }
}
